    "orf_finder": {
      "input": "nucleotide_fasta",
      "outputs": [
        "report"
      ],
      "inputPattern": "sequence|fasta",
      "submitPattern": "submit|orf|search",
      "resultPatterns": [
        "ORFs found:",
        "Strand.*Frame.*Start.*Stop.*Length"
      ],
      "parameters": [
        {
          "id": "geneticCode",
          "label": "遗传密码表 / Genetic code",
          "required": true,
          "default": "1. Standard"
        },
        {
          "id": "startCodon",
          "label": "起始密码子 / Start codon",
          "required": true,
          "default": "ATG only",
          "aliases": {
            "ATG only": [
              "\"ATG\" only"
            ]
          }
        }
      ],
      "emailNotification": {
        "support": "unknown",
        "evidence": "docs/acceptance/orf_finder-observation.json",
        "note": "尚未核实通知能力；不传递邮箱 / Notification capability not confirmed; no email forwarded"
      }
    },
    "blastn": {
