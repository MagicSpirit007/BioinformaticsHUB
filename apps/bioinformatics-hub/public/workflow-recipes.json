        "Query.*Length|Query ID"
      ],
      "jobPattern": "RID[= :]+([A-Z0-9-]+)",
      "parameters": [
        {
          "id": "database",
          "label": "数据库 / Database",
          "required": true,
          "default": "Nucleotide collection (nr/nt)"
        },
        {
          "id": "program",
          "label": "算法 / Program",
          "required": true,
          "default": "Highly similar sequences (megablast)",
          "aliases": {
            "Highly similar sequences (megablast)": [
              "Optimize for Highly similar sequences (megablast)"
            ]
          }
        },
        {
          "id": "expect",
          "label": "E-value",
          "required": true,
          "default": "0.05"
        }
      ],
      "pollUrlPattern": "[?&]RID=[A-Z0-9-]+",
      "emailNotification": {
        "support": "unknown",
        "evidence": "docs/acceptance/blastn-observation.json",
        "note": "尚未核实通知能力；不传递邮箱 / Notification capability not confirmed; no email forwarded"
      }
