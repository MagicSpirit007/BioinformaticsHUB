{
  "name": "bioinformatics-hub-desktop",
  "private": true,
  "version": "0.7.0",
  "description": "Bioinformatics analysis tools for external AI and original result directory",
  "author": "MagicSpirit007",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check main.cjs && node --check paths.cjs && node --check preload.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "dist:nsis": "electron-builder --win nsis --x64",
    "cli": "node workflow/entry.cjs",
    "mcp": "node workflow/entry.cjs mcp"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bioinformaticshub.app",
    "productName": "BioinformaticsHUB",
    "copyright": "Copyright © 2026 MagicSpirit007",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "paths.cjs",
      "preload.cjs",
      "workflow/**/*",
      "fallback.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bioinformatics-hub/dist",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packaging/engine",
        "to": "engine",
        "filter": [
          "scripts/**/*",
          "doctor.py",
          "install_tools.ps1",
          "requirements-engine.txt",
          "requirements-browser.txt",
          "THIRD_PARTY_NOTICES.md",
          "build-manifest.json",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.doctor_mpl.png",
          "!**/runs/**",
          "!**/.env*",
          "!**/.venv/**",
          "!**/artifacts/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BioinformaticsHUB",
      "deleteAppDataOnUninstall": false
    },
    "extraFiles": [
      {
        "from": "../../packaging/biohub.cmd",
        "to": "biohub.cmd"
      }
    ],
    "asarUnpack": [
      "workflow/open-browser.ps1"
    ]
  }
}
